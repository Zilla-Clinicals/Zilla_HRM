# Deployment environment: "dev" (permissive) or "production".
# When ENV=production the app REFUSES to start unless JWT_SECRET is a strong
# random value (>=32 chars) and COOKIE_SECURE=true — see app/config.py.
ENV=dev

# Postgres
DATABASE_URL=postgresql+asyncpg://hrm:hrm@localhost:5432/hrm

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Cookies (dev vs prod)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Email (resend | console). "console" prints links to stdout for local dev.
EMAIL_PROVIDER=console
RESEND_API_KEY=re_...
EMAIL_FROM=HRM <noreply@zillaclinicals.com>
APP_BASE_URL=http://localhost:5173
